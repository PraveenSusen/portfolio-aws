pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t portfolio-app:v1 .'
            }
        }

        stage('Verify Image') {
            steps {
                bat 'docker images'
            }
        }

        stage('Deploy Container') {
            steps {
                bat 'docker stop portfolio-container'
                bat 'docker rm portfolio-container'
                bat 'docker run -d --name portfolio-container -p 8081:80 portfolio-app:v1'
            }
        }

        stage('Health Check') {
            steps {
                bat 'curl http://localhost:8081'
            }
        }
    }
}